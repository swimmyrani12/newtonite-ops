# Application Environment Configuration
APP_ENV=development
APP_NAME="Newtonite Operations Under Pressure"

# Database Configuration
# Local SQLite default (runs with zero setup):
DATABASE_URL=sqlite:///./newtonite_ops.db

# Docker / Production PostgreSQL configuration:
# DATABASE_URL=postgresql://newtonite_admin:newtonite_secure_password@localhost:5432/newtonite_ops

# Authentication & Security
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Asynchronous Outbox Worker
OUTBOX_POLL_INTERVAL_SECONDS=2.0
